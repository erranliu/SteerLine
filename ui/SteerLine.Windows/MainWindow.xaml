<Window
    x:Class="SteerLine.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:SteerLine.Windows.Core"
    Title="SteerLine">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="20" Spacing="12">
            <TextBlock Text="SteerLine" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="连接现有服务并查看实时任务。此窗口不会启动或停止服务。" TextWrapping="Wrap" />

            <TextBlock Text="服务配置" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ConfigPathBox" Grid.Column="0" PlaceholderText="选择 home\etc 下的项目 JSON 配置"
                         AutomationProperties.Name="{x:Bind ViewModel.ConfigPathLabel}" />
                <Button Grid.Column="1" Content="选择配置…" Click="OnChooseConfigClick" AutomationProperties.Name="选择服务配置文件" />
            </Grid>

            <TextBlock Text="项目目录" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectPathBox" Grid.Column="0" PlaceholderText="选择配置中 repository 指向的目录"
                         AutomationProperties.Name="{x:Bind ViewModel.ProjectPathLabel}" />
                <Button Grid.Column="1" Content="选择目录…" Click="OnChooseProjectClick" AutomationProperties.Name="选择项目目录" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectButton" Content="连接现有服务" Click="OnConnectClick"
                        AutomationProperties.Name="{x:Bind ViewModel.ConnectLabel}" />
                <Button x:Name="RefreshButton" Content="刷新任务" Click="OnRefreshClick" />
            </StackPanel>
            <TextBlock Text="连接状态" Style="{ThemeResource CaptionTextBlockStyle}"
                       AutomationProperties.Name="{x:Bind ViewModel.ConnectionStatusLabel}" />
            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.Name="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />

            <TextBlock Text="任务" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView x:Name="TasksList" ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}" SelectionMode="Single"
                      SelectionChanged="OnTaskSelectionChanged" MinHeight="120" MaxHeight="250"
                      AutomationProperties.Name="{x:Bind ViewModel.TaskListLabel}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:TaskSummary">
                        <Grid ColumnSpacing="10" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TaskId}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.TargetStatus, Mode=OneWay}" TextWrapping="Wrap" />

            <TextBlock Text="未发送输入" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="DraftEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="输入内容；Enter 换行，组词确认不会提交。"
                     TextChanged="OnDraftTextChanged" AutomationProperties.Name="{x:Bind ViewModel.InputLabel}" />
            <Button Content="记录本地提交意图" Click="OnRecordIntentClick"
                    AutomationProperties.Name="{x:Bind ViewModel.SubmitIntentLabel}" />
            <TextBlock Text="本地提交状态" Style="{ThemeResource CaptionTextBlockStyle}"
                       AutomationProperties.Name="{x:Bind ViewModel.IntentStatusLabel}" />
            <TextBlock Text="{x:Bind ViewModel.IntentStatus, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.Name="{x:Bind ViewModel.IntentStatus, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Window>
