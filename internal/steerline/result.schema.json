{
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "run_id", "outcome", "pr_url", "worktree_path", "base_commit", "summary", "error"],
  "properties": {
    "task_id": {"type": "string"},
    "run_id": {"type": "string"},
    "outcome": {"type": "string", "enum": ["pr_submitted", "blocked", "needs_decision"]},
    "pr_url": {"type": ["string", "null"]},
    "worktree_path": {"type": ["string", "null"]},
    "base_commit": {"type": ["string", "null"]},
    "summary": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "decision_application": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decision_id", "attempt_id", "execution_id", "execution_ref_sha256", "answer_sha256"],
      "properties": {
        "decision_id": {"type": "string"},
        "attempt_id": {"type": "string"},
        "execution_id": {"type": "string"},
        "execution_ref_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "answer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": {"type": "string"},
        "context": {"type": "string"},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "detail": {"type": "string"}
            }
          }
        },
        "recommended": {"type": "string"},
        "allow_free_text": {"type": "boolean"}
      }
    }
  }
}
