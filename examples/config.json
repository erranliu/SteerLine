{
  "repository": "C:/Projects/my-existing-repo",
  "remote": "origin",
  "branch": "main",
  "run_dir": "C:/SteerlineRuntime/my-existing-repo",
  "worktree_root": "C:/SteerlineRuntime/my-existing-repo/worktrees",
  "runtime_file": "runtime.json",
  "claimant": "",
  "git": {"executable": "git.exe", "args": []},
  "bd": {"executable": "bd.exe", "args": []},
  "codex": {"executable": "C:/Tools/codex/codex.exe", "args": []},
  "workflow_definition": {
    "id": "minimal-v1",
    "version": "minimal-v1",
    "review_required": true,
    "max_repair_rounds": 2
  },
  "project_steps": {
    "implement": {
      "provider": "agent_skill",
      "entry": "builtin:implement",
      "version": "minimal-v1",
      "input_schema": "steerline/minimal-step-input/v1",
      "output_schema": "steerline/minimal-step-result/v1",
      "execution_site": "local",
      "timeout": "30m"
    },
    "verify": {
      "provider": "agent_skill",
      "entry": "builtin:verify",
      "version": "minimal-v1",
      "input_schema": "steerline/minimal-step-input/v1",
      "output_schema": "steerline/minimal-step-result/v1",
      "execution_site": "local",
      "timeout": "15m",
      "required_checks": ["unit", "lint"]
    },
    "review": {
      "provider": "agent_skill",
      "entry": "builtin:review",
      "version": "minimal-v1",
      "input_schema": "steerline/minimal-step-input/v1",
      "output_schema": "steerline/minimal-step-result/v1",
      "execution_site": "local",
      "timeout": "15m"
    },
    "publish_pr": {
      "provider": "agent_skill",
      "entry": "builtin:publish_pr",
      "version": "minimal-v1",
      "input_schema": "steerline/minimal-step-input/v1",
      "output_schema": "steerline/minimal-step-result/v1",
      "execution_site": "local",
      "timeout": "15m"
    }
  },
  "executable_types": ["task", "bug", "feature", "chore"],
  "task_poll": "10s",
  "pr_poll": "30s",
  "heartbeat": "5s",
  "command_timeout": "30s",
  "shutdown_grace": "10s",
  "sandbox": "workspace-write",
  "model": "",
  "reasoning_effort": "",
  "profile": "",
  "agent": "codex",
  "host": "local",
  "stall_timeout": "5m",
  "completion": null,
  "pr": {
    "kind": "gitea",
    "base_url": "https://gitea.example.com",
    "repository": "owner/my-existing-repo",
    "token_env": "STEERLINE_GITEA_TOKEN",
    "query": {"executable": "", "args": []}
  }
}
