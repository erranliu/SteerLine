{
  "version": 3,
  "runner": {
    "executable": "C:/Tools/SteerRunner/steerrunner.exe",
    "version": "0.1.0-dev.1",
    "sha256": "REPLACE_WITH_THE_SELECTED_EXE_SHA256"
  },
  "default_execution_profile": "local-luna-medium",
  "execution_profiles": [
    {
      "id": "local-luna-medium",
      "name": "本机 Codex Luna medium",
      "execution": {
        "adapter": "codex-app-server",
        "target": {
          "kind": "local"
        },
        "settings": {
          "executable": "codex.exe",
          "model": "gpt-6-luna",
          "reasoning_effort": "medium"
        }
      },
      "workflow": {
        "id": "development",
        "version": 1
      }
    },
    {
      "id": "local-audited",
      "name": "本机 Codex 审计流程",
      "execution": {
        "adapter": "codex-app-server",
        "target": {
          "kind": "local"
        },
        "settings": {
          "executable": "codex.exe",
          "model": "gpt-6-luna",
          "reasoning_effort": "medium"
        }
      },
      "workflow": {
        "id": "development-audited",
        "version": 1,
        "audit_model": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "high"
        }
      }
    },
    {
      "id": "local-luna-xhigh",
      "name": "本机 Codex Luna xhigh",
      "execution": {
        "adapter": "codex-app-server",
        "target": {
          "kind": "local"
        },
        "settings": {
          "executable": "codex.exe",
          "model": "gpt-6-luna",
          "reasoning_effort": "xhigh"
        }
      },
      "workflow": {
        "id": "development",
        "version": 1
      }
    },
    {
      "id": "orca-environment",
      "name": "远端 Orca",
      "execution": {
        "adapter": "orca-terminal",
        "target": {
          "kind": "orca_environment",
          "environment": "台式机64G"
        },
        "settings": {
          "transport": {
            "executable": "orca.exe",
            "wait_timeout": "30s"
          },
          "agent_launch": {
            "runtime_executable": "C:/Tools/SteerRunner/steerrunner-agent.exe",
            "runtime_sha256": "REPLACE_WITH_EXECUTION_HOST_HELPER_SHA256",
            "executable": "codex",
            "model": "gpt-6-luna",
            "reasoning_effort": "medium",
            "args": ["--no-daemon"]
          }
        }
      },
      "workflow": {
        "id": "development",
        "version": 1
      }
    }
  ]
}
