{
  "version": 2,
  "default_execution_profile": "local-luna-medium",
  "execution_profiles": [
    {
      "id": "local-luna-medium",
      "name": "本机 Codex Luna medium",
      "host": "local",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "codex.worker-profile",
          "codec_version": 1,
          "payload": {
            "executable": "codex.exe",
            "model": "gpt-6-luna",
            "reasoning_effort": "medium",
            "windows_sandbox": "elevated"
          }
        }
      ],
      "publication_policy": {"publisher": "host_service"}
    },
    {
      "id": "local-luna-xhigh",
      "name": "本机 Codex Luna xhigh",
      "host": "local",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "codex.worker-profile",
          "codec_version": 1,
          "payload": {
            "executable": "codex.exe",
            "model": "gpt-6-luna",
            "reasoning_effort": "xhigh",
            "windows_sandbox": "elevated"
          }
        }
      ],
      "publication_policy": {"publisher": "host_service"}
    },
    {
      "id": "orca-local-luna-xhigh",
      "name": "本机 Orca + Codex Luna xhigh",
      "host": "orca",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "codex.worker-profile",
          "codec_version": 1,
          "payload": {
            "executable": "codex.exe",
            "model": "gpt-6-luna",
            "reasoning_effort": "xhigh",
            "windows_sandbox": "unelevated"
          }
        },
        {
          "implementation_key": "orca.worker-profile",
          "codec_version": 1,
          "payload": {
            "executable": "orca.exe",
            "shell": "powershell.exe",
            "wait_timeout": "15m"
          }
        }
      ],
      "publication_policy": {"publisher": "worker"}
    },
    {
      "id": "orca-local-luna-medium",
