{
  "version": 2,
  "default_execution_profile": "local-luna-medium",
  "execution_profiles": [
    {
      "id": "local-luna-medium",
      "name": "本机 Codex Luna medium",
      "host": "local",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "codex.worker-profile",
          "codec_version": 2,
          "payload": {
            "executable": "codex.exe",
            "model": "gpt-6-luna",
            "reasoning_effort": "medium"
          }
        }
      ]
    },
    {
      "id": "local-luna-xhigh",
      "name": "本机 Codex Luna xhigh",
      "host": "local",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "codex.worker-profile",
          "codec_version": 2,
          "payload": {
            "executable": "codex.exe",
            "model": "gpt-6-luna",
            "reasoning_effort": "xhigh"
          }
        }
      ]
    },
    {
      "id": "orca-local",
      "name": "本机 Orca 原生配置",
      "host": "orca",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "orca.terminal-profile",
          "codec_version": 2,
          "payload": {
            "executable": "orca.exe",
            "environment": "",
            "repository_selector": "path:__LOCAL_ORCA_REPOSITORY__",
            "wait_timeout": "30s"
          }
        }
      ]
    },
    {
      "id": "orca-environment",
      "name": "远端 Orca 原生配置",
      "host": "orca",
      "agent": "codex",
      "implementation_configs": [
        {
          "implementation_key": "orca.terminal-profile",
          "codec_version": 2,
          "payload": {
            "executable": "orca.exe",
            "environment": "__ORCA_ENVIRONMENT__",
            "repository_selector": "id:__REMOTE_ORCA_REPOSITORY__",
            "wait_timeout": "30s"
          }
        }
      ]
    }
  ]
}
