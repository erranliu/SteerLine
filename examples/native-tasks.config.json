{
  "repository": "/absolute/path/to/repository",
  "remote": "origin",
  "branch": "main",
  "task_authority": "native",
  "git": {
    "executable": "git"
  },
  "workflow_protocol": "worker-flow-v2",
  "executable_types": [
    "task",
    "bug",
    "feature",
    "chore"
  ],
  "pr": {
    "kind": "gitea",
    "base_url": "https://gitea.example.com",
    "repository": "owner/repository",
    "token_env": "GITEA_TOKEN"
  },
  "publication_policy": {
    "publisher": "worker"
  }
}
