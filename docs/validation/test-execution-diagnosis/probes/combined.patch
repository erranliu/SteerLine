+func TestDiagnosticSeedIsolation(t *testing.T) {
+ a,ac:=nativeTaskFixture(t);b,bc:=nativeTaskFixture(t)
+ if a.Repository==b.Repository || ac=="" || bc=="" {t.Fatal("fixture identity reused")}
+ path:=filepath.Join(a.Repository,"only-a.txt");require(t,os.WriteFile(path,[]byte("A"),0600))
+ if _,err:=os.Stat(filepath.Join(b.Repository,"only-a.txt"));!os.IsNotExist(err){t.Fatalf("fixture files shared: %v",err)}
+ ao,err:=exec.Command("git","-C",a.Repository,"remote","get-url","origin").Output();require(t,err)
+ bo,err:=exec.Command("git","-C",b.Repository,"remote","get-url","origin").Output();require(t,err)
+ if strings.TrimSpace(string(ao))==strings.TrimSpace(string(bo)){t.Fatal("fixture remotes shared")}
+ require(t,os.WriteFile(filepath.Join(strings.TrimSpace(string(ao)),"only-a"),[]byte("A"),0600))
+ if _,err:=os.Stat(filepath.Join(strings.TrimSpace(string(bo)),"only-a"));!os.IsNotExist(err){t.Fatalf("bare remotes shared: %v",err)}
+}
